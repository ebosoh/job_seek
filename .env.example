# ------------------------------------------------------------------------------
# 2. LLM CONFIGURATION (For open question generation & email classification)
# ------------------------------------------------------------------------------
# Provider options: "gemini" or "openai"
LLM_PROVIDER="gemini"

# Gemini API Key (Required if LLM_PROVIDER="gemini")
GEMINI_API_KEY=""
