# OpenAI API Key (Required if LLM_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. LINKEDIN BROWSER CONFIGURATION
# ------------------------------------------------------------------------------
# Path to persistent Chrome/Chromium user session directory
BROWSER_USER_DATA_DIR="sessions/linkedin_profile"

# Run browser in headless mode (False recommended for first-time login & debugging)
HEADLESS=False

# Slow motion delay (milliseconds) between actions to mimic human interaction
SLOW_MO_MS=150

# ------------------------------------------------------------------------------
# 4. APPLICATION & SEARCH CRITERIA
# ------------------------------------------------------------------------------
# Location filter: Remote ONLY
SEARCH_LOCATION="Remote"

# Minimum IILS score to trigger auto-apply (0 - 100)
IILS_AUTO_APPLY_THRESHOLD=70

# Minimum IILS score to save non-Easy Apply jobs for manual review (0 - 100)
IILS_EXTERNAL_REVIEW_THRESHOLD=80

# Salary inputs for application forms
DEFAULT_SALARY_YEARLY=60000
DEFAULT_SALARY_MONTHLY=5000
SALARY_CURRENCY="USD"

# Safety confidence threshold (0 - 100). If LLM confidence < 85%, flags for manual completion
SAFETY_CONFIDENCE_THRESHOLD=85

# Maximum applications per run cycle
MAX_APPLICATIONS_PER_RUN=15

# Dry run mode: if True, fills form but does not click the final "Submit" button
DRY_RUN=False

# ------------------------------------------------------------------------------
